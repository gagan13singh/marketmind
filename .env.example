# MarketMind reads live NSE data from Angel One SmartAPI.
# Without these four variables the app still runs, but every price is
# generated sample data and is labelled as such throughout the UI.
#
# Where each value comes from:
#   1. Create an account at https://smartapi.angelbroking.com and register an
#      app of type "Trading API". That gives you the API key.
#   2. ANGEL_CLIENT_CODE is your Angel One login ID (e.g. A123456).
#   3. ANGEL_PIN is the numeric PIN you use to log in.
#   4. Enable TOTP on your account. ANGEL_TOTP_SECRET is the base32 string
#      shown next to the QR code — the same one you would paste into an
#      authenticator app. Not a six-digit code; the secret behind it.
#
# Make sure "Historical Data" is enabled for the API key in the SmartAPI
# dashboard, otherwise candles come back empty while login still succeeds.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Force generated sample data instead of fetching live prices. Useful for
# offline development and deterministic screenshots. Every price becomes fake,
# so leave it unset in production.
# MARKETMIND_FORCE_SAMPLE=true

# How long a single screener run may spend fetching, in milliseconds.
# The default (40000) sits under the 60-second serverless ceiling, which means
# a full-universe scan needs several runs — the UI has a "Continue scan" button
# for that, and each run resumes from the cache.
# On a self-hosted server with no request timeout, raise this so the whole
# universe finishes in one run. Measured throughput is roughly 2.2 symbols per
# second once overhead is counted, so ~3,150 stocks needs about 25 minutes.
# 30 minutes leaves headroom.
# MARKETMIND_SCAN_BUDGET_MS=1800000

# How long to wait for Angel One's instrument master (the "scrip master").
# That file lists every instrument on every segment and is tens of megabytes,
# so on a slow connection the default 120 seconds can still be too short —
# /api/health will say so explicitly if it times out.
# The download runs in the background and pages fall back to sample data while
# it is in flight, so raising this does not make anything hang.
# ANGEL_SCRIP_TIMEOUT_MS=120000

# Point the Angel One client at a different gateway. Intended for testing
# against a stand-in; leave unset in production.
# ANGEL_API_BASE=https://apiconnect.angelone.in
# ANGEL_SCRIP_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
